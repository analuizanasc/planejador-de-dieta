PORT=3000
JWT_SECRET=
# Chave da API do Gemini (Google AI Studio). Exigida apenas no momento da
# importação de receita do Instagram — o servidor sobe normalmente sem ela.
GEMINI_API_KEY=
# Opcional: modelo do Gemini a usar na extração (padrão: gemini-2.5-flash).
GEMINI_MODEL=
# Token da API do Apify. Com ele, a importação usa o Apify (alcança legenda,
# comentários e vídeo mesmo com o Instagram bloqueando scraping anônimo).
# Sem ele, cai no scraper anônimo de meta tags (frágil). Exigido só na chamada.
APIFY_API_TOKEN=
# Opcional: actor do Apify a usar (padrão: apify~instagram-scraper).
APIFY_INSTAGRAM_ACTOR=
# Chave da YouTube Data API v3 (Google Cloud). Com ela, a importação de vídeos
# do YouTube tenta extrair a receita da DESCRIÇÃO (texto barato) antes de
# recorrer ao vídeo no Gemini (que custa mais tokens). Sem ela, vai direto pro
# vídeo. Opcional; exigida só na importação de YouTube.
YOUTUBE_API_KEY=
