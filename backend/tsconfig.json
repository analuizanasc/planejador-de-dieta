{
  "compilerOptions": {
    /* Alvo e módulos: o backend é CommonJS (require/module.exports). Como o
       package.json não tem "type":"module", o modo node16 emite CommonJS,
       mantendo a resolução moderna (o "node" clássico foi descontinuado no TS 6). */
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],

    /* Coexistência .js + .ts durante a migração incremental. */
    "allowJs": true,
    "checkJs": false,

    /* Interop com pacotes CommonJS (jsonwebtoken, express) usando import default. */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Rigor de tipos — vale só para os .ts (checkJs=false poupa os .js legados). */
    "strict": true,

    /* Cada arquivo é transpilado isoladamente (modelo do ts-jest/tsx),
       exigido pelo module=node16 e evita construções que dependem do type-check global. */
    "isolatedModules": true,

    /* Build: transpila src/ para dist/, preservando a árvore de pastas. */
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": false,

    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "coverage"]
}
